
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Portal de Autoatendimento - CST</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background-color: #0b131e; color: #e2e8f0; padding: 30px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #111827; padding: 20px 30px; border-radius: 10px; border: 1px solid #1f2937; margin-bottom: 30px; }
        .header h2 { color: #38bdf8; font-size: 22px; }
        .logout-btn { background: #ef4444; color: #fff; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 13px; }
        .grid-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .tool-card { background: #111827; border: 1px solid #1f2937; border-radius: 10px; padding: 25px; transition: transform 0.2s; }
        .tool-card:hover { transform: translateY(-3px); border-color: #0284c7; }
        .tool-card i { font-size: 28px; color: #38bdf8; margin-bottom: 15px; }
        .tool-card h3 { font-size: 16px; margin-bottom: 10px; color: #fff; }
        .tool-card p { font-size: 13px; color: #94a3b8; margin-bottom: 20px; }
        .btn-acao { background: #0284c7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px; }
        .btn-acao:hover { background: #0284c7; }
    </style>
</head>
<body>
    <div class="header">
        <div>
            <h2>🛠️ Portal de Autoatendimento CST</h2>
            <p style="color: #94a3b8; font-size: 13px; margin-top: 5px;">Usuário conectado: <strong style="color: #fff;"><%= usuario.login %></strong></p>
        </div>
        <a href="/logout" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
    </div>

    <div class="grid-tools">
        <div class="tool-card">
            <i class="fa-solid fa-broom"></i>
            <h3>Limpeza de Cache do Sistema</h3>
            <p>Remove arquivos temporários e libera espaço no seu perfil de usuário local.</p>
            <button class="btn-acao" onclick="executarAutoAtendimento('limpar_cache')">Executar Limpeza</button>
        </div>

        <div class="tool-card">
            <i class="fa-solid fa-print"></i>
            <h3>Reiniciar Fila de Impressão</h3>
            <p>Corrige impressoras travadas ou documentos presos no Spooler.</p>
            <button class="btn-acao" onclick="executarAutoAtendimento('destravar_impressora')">Reiniciar Spooler</button>
        </div>

        <div class="tool-card">
            <i class="fa-solid fa-network-wired"></i>
            <h3>Diagnóstico de Rede</h3>
            <p>Verifica a conectividade com os servidores e Active Directory da CST.</p>
            <button class="btn-acao" onclick="alert('Rede conectada ao Domínio CST Local.')">Testar Conexão</button>
        </div>
    </div>
<div class="grid-tools">
        <div class="tool-card">
            <i class="fa-solid fa-broom"></i>
            <h3>Limpeza de Cache do Sistema</h3>
            <p>Remove arquivos temporários e libera espaço no seu perfil de usuário local.</p>
            <button class="btn-acao" onclick="executarAutoAtendimento('limpar_cache')">Executar Limpeza</button>
        </div>

        <div class="tool-card">
            <i class="fa-solid fa-print"></i>
            <h3>Reiniciar Fila de Impressão</h3>
            <p>Corrige impressoras travadas ou documentos presos no Spooler.</p>
            <button class="btn-acao" onclick="executarAutoAtendimento('destravar_impressora')">Reiniciar Spooler</button>
        </div>

        <div class="tool-card">
            <i class="fa-solid fa-network-wired"></i>
            <h3>Diagnóstico de Rede</h3>
            <p>Verifica a conectividade com os servidores e Active Directory da CST.</p>
            <button class="btn-acao" onclick="alert('Rede conectada ao Domínio CST Local.')">Testar Conexão</button>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 📍 COLOQUE A ETAPA 3 EXATAMENTE AQUI:      -->
    <!-- ========================================== -->
    <script>
        async function executarAutoAtendimento(acao) {
            if (!confirm("Deseja executar esta ferramenta de reparo?")) return;
            
            try {
                const response = await fetch('/executar-reparo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ acao })
                });
                
                const resultado = await response.json();
                if (resultado.sucesso) {
                    alert("Sucesso: " + resultado.mensagem);
                } else {
                    alert("Erro: " + resultado.erro);
                }
            } catch (err) {
                alert("Erro de comunicação com o servidor de suporte.");
            }
        }
    </script>
</body>
</html>
    <script>
        async function executarAutoAtendimento(acao) {
            if (!confirm("Deseja executar esta ferramenta de reparo em sua estação?")) return;
            alert("Comando de autoatendimento enviado com sucesso para sua máquina.");
        }
    </script>
</body>
</html>
