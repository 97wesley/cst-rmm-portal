  <script>
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      const ctx = canvas.getContext('2d');
      let width, height, particles = [];
      const mouse = { x: null, y: null, radius: 150 };
      window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
      window.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });
      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        particles = Array.from({ length: Math.min(90, Math.floor((width * height) / 14000)) }, () => ({
          x: Math.random() * width, y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.65, vy: (Math.random() - 0.5) * 0.65, size: Math.random() * 2.2 + 1
        }));
      }
      function animar() {
        ctx.clearRect(0, 0, width, height);
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          if (mouse.x !== null) {
            const dx = mouse.x - p.x, dy = mouse.y - p.y, dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < mouse.radius) { p.x -= (dx/dist)*1.3; p.y -= (dy/dist)*1.3; }
          }
          ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
          ctx.fillStyle = 'rgba(56, 189, 248, 0.75)'; ctx.fill();
          for (let j = i + 1; j < particles.length; j++) {
            const p2 = particles[j], dx = p.x - p2.x, dy = p.y - p2.y, dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 130) {
              ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = `rgba(99, 102, 241, ${(1 - dist/130)*0.35})`; ctx.stroke();
            }
          }
        }
        requestAnimationFrame(animar);
      }
      window.addEventListener('resize', resize); resize(); animar();
    })();
  </script>

