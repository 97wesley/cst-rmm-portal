cat << 'EOF' > ~/cst-rmm-portal/views/colaborador.ejs
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>CST Autoatendimento TI</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { margin: 0; background: #f1f5f9; color: #0f172a; }
    .header { background: #0f172a; color: #fff; padding: 16px 28px; display: flex; justify-content: space-between; align-items: center; }
    .header h1 { margin: 0; font-size: 18px; color: #38bdf8; }
    .btn-sair { background: #ef4444; color: #fff; text-decoration: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 13px; }
    .wrap { max-width: 1120px; margin: 28px auto; padding: 0 20px; }
    .status-bar { background: #fff; border-radius: 12px; padding: 16px 22px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 15px rgba(15,23,42,0.06); margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
    .pill-ok { background: #dcfce7; color: #166534; padding: 5px 12px; border-radius: 99px; font-weight: 700; font-size: 12.5px; }
    .pill-warn { background: #fef3c7; color: #92400e; padding: 5px 12px; border-radius: 99px; font-weight: 700; font-size: 12.5px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px; }
    .card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 4px 15px rgba(15,23,42,0.06); border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; }
    .card h3 { margin: 0 0 8px 0; font-size: 16px; color: #0f172a; }
    .card p { margin: 0 0 16px 0; font-size: 13px; color: #64748b; line-height: 1.45; }
    .btn-fix { background: #0284c7; color: #fff; border: none; padding: 11px 14px; border-radius: 9px; font-weight: 700; font-size: 13.5px; cursor: pointer; width: 100%; transition: 0.2s; margin-bottom: 8px; }
    .btn-fix:hover { background: #0369a1; }
    .btn-sec { background: #f8fafc; color: #0f172a; border: 1px solid #cbd5e1; padding: 9px 12px; border-radius: 8px; font-weight: 600; font-size: 12.5px; cursor: pointer; width: 100%; margin-bottom: 6px; }
    .btn-sec:hover { background: #e2e8f0; }

    /* Caixa de Resultado Ao Vivo */
    .result-panel { margin-top: 24px; background: #fff; border-radius: 14px; padding: 20px; border-left: 6px solid #0284c7; box-shadow: 0 8px 25px rgba(15,23,42,0.08); display: none; }
    .result-panel.show { display: block; }
    .result-panel.sucesso { border-left-color: #16a34a; }
    .result-panel.erro { border-left-color: #dc2626; }
    .tech-details { background: #0f172a; color: #38bdf8; padding: 12px; border-radius: 8px; font-family: Consolas, monospace; font-size: 12px; margin-top: 12px; white-space: pre-wrap; max-height: 220px; overflow-y: auto; }
  </style>
</head>
<body>
  <% const nomeColab = typeof usuario === 'object' && usuario !== null ? (usuario.nome || usuario.login || 'Colaborador') : (usuario || 'Colaborador'); %>

  <div class="header">
    <h1>🛠️ CST — Central de Autoatendimento TI</h1>
    <div style="display:flex; align-items:center; gap:14px;">
      <span style="font-size:13.5px;">Olá, <strong><%= nomeColab %></strong></span>
      <a href="/logout" class="btn-sair">Sair</a>
    </div>
  </div>

  <div class="wrap">
    <div class="status-bar">
      <div>
        <strong style="font-size:15px;">Estação Vinculada:</strong>
        <span id="minhaMaquina" style="color:#0284c7; font-weight:700; margin-left:6px;">Localizando computador na rede...</span>
      </div>
      <span id="statusSinc" class="pill-warn">Sincronizando (5s)...</span>
    </div>

    <div class="grid">
      <div class="card">
        <div>
          <h3>🚀 Computador Lento ou Travando</h3>
          <p>Limpa arquivos temporários do Windows e o cache acumulado dos navegadores sem apagar suas senhas.</p>
        </div>
        <div>
          <button class="btn-fix" onclick="solicitarReparo('limpar_cache', 'Limpeza de Cache do Sistema')">Limpar Arquivos Temporários</button>
          <button class="btn-sec" onclick="solicitarReparo('limpar_navegadores', 'Limpeza de Cache dos Navegadores')">Limpar Cache Chrome / Edge / Firefox</button>
        </div>
      </div>

      <div class="card">
        <div>
          <h3>🖨️ Problemas na Impressora</h3>
          <p>Destrava documentos parados na fila e reinicia o serviço de impressão da sua estação.</p>
        </div>
        <div>
          <button class="btn-fix" onclick="solicitarReparo('destravar_impressora', 'Reinicio do Spooler de Impressão')">Destravar & Reiniciar Impressora</button>
          <button class="btn-sec" onclick="solicitarReparo('limpar_fila_impressao', 'Limpeza da Fila de Impressão')">Limpar Documentos Presos</button>
        </div>
      </div>

      <div class="card">
        <div>
          <h3>🌐 Internet ou Sistema Fora</h3>
          <p>Atualiza o endereço de rede e limpa o cache DNS quando algum sistema interno ou site não abre.</p>
        </div>
        <div>
          <button class="btn-fix" onclick="solicitarReparo('flush_dns', 'Limpeza de Cache DNS')">Corrigir Acesso / Limpar DNS</button>
          <button class="btn-sec" onclick="solicitarReparo('renovar_ip', 'Renovação de IP na Rede')">Renovar Conexão de Rede (IP)</button>
        </div>
      </div>

      <div class="card">
        <div>
          <h3>🖥️ Tela, Políticas e Horário</h3>
          <p>Reinicia o driver gráfico se a tela piscar/travar ou sincroniza suas permissões com o servidor da empresa.</p>
        </div>
        <div>
          <button class="btn-fix" onclick="solicitarReparo('reiniciar_video', 'Reinício do Driver de Vídeo')">Destravar Tela / Vídeo</button>
          <button class="btn-sec" onclick="solicitarReparo('atualizar_gpo', 'Atualização de Políticas da Empresa')">Atualizar Permissões (GPO)</button>
        </div>
      </div>
    </div>

    <!-- Resultado Ao Vivo na Tela -->
    <div id="painelResultado" class="result-panel">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <strong id="resTitulo" style="font-size:16px;">Executando diagnóstico...</strong>
        <span id="resHora" style="font-size:12px; color:#64748b;"></span>
      </div>
      <p id="resResumo" style="margin:8px 0 0 0; font-size:14px;"></p>
      <div id="resDetalhes" class="tech-details"></div>
    </div>
  </div>

  <script>
    const loginAtual = "<%= typeof usuario === 'object' && usuario !== null ? (usuario.login || '') : (usuario || '') %>".toLowerCase();
    let hostnameAlvo = 'AUTO';

    async function sincronizarMinhaEstacao() {
      try {
        const res = await fetch('/api/estacoes');
        const lista = await res.json();
        const minha = lista.find(e => e.usuario && loginAtual && e.usuario.toLowerCase().includes(loginAtual)) || lista.find(e => e.online);
        const pill = document.getElementById('statusSinc');
        if (minha) {
          hostnameAlvo = minha.hostname;
          document.getElementById('minhaMaquina').innerText = `${minha.hostname} (IP: ${minha.ip})`;
          pill.className = minha.online ? 'pill-ok' : 'pill-warn';
          pill.innerText = minha.online ? '● Estação Online e Sincronizada' : '● Estação Offline';
        } else {
          document.getElementById('minhaMaquina').innerText = 'Identificação automática por IP';
          pill.className = 'pill-warn';
          pill.innerText = 'Aguardando agente na estação';
        }
      } catch (e) {}
    }

    async function solicitarReparo(acao, nomeAmigavel) {
      const painel = document.getElementById('painelResultado');
      const titulo = document.getElementById('resTitulo');
      const resumo = document.getElementById('resResumo');
      const detalhes = document.getElementById('resDetalhes');

      painel.className = 'result-panel show';
      titulo.innerText = '⏳ Executando: ' + nomeAmigavel + '...';
      resumo.innerText = 'Aguardando resposta em tempo real da sua estação de trabalho...';
      detalhes.innerText = 'Enviando instrução para ' + hostnameAlvo + '...';

      const res = await fetch('/api/comando', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hostname: hostnameAlvo, acao })
      });
      const data = await res.json();

      if (!data.ok) {
        painel.className = 'result-panel show erro';
        titulo.innerText = '❌ Não foi possível executar';
        resumo.innerText = data.erro || 'Estação não respondeu.';
        detalhes.innerText = 'Verifique se o agente CST RMM está ativo nesta estação.';
        return;
      }

      let tentativas = 0;
      const timer = setInterval(async () => {
        tentativas++;
        const r = await fetch('/api/comando/' + data.id);
        const st = await r.json();
        if (st.concluido) {
          clearInterval(timer);
          painel.className = st.sucesso ? 'result-panel show sucesso' : 'result-panel show erro';
          titulo.innerText = st.sucesso ? '✅ Concluído com Sucesso: ' + nomeAmigavel : '❌ Erro ao Executar: ' + nomeAmigavel;
          resumo.innerText = st.sucesso
            ? 'A ação foi aplicada diretamente no computador ' + st.hostname + '.'
            : 'Houve uma falha durante a execução no computador ' + st.hostname + '.';
          document.getElementById('resHora').innerText = 'Finalizado às ' + st.finalizadoEm;
          detalhes.innerText = st.saida;
        } else if (tentativas > 25) {
          clearInterval(timer);
          painel.className = 'result-panel show erro';
          titulo.innerText = '⚠️ Tempo limite excedido';
          resumo.innerText = 'A estação ' + data.hostname + ' demorou para responder.';
        }
      }, 1000);
    }

    sincronizarMinhaEstacao();
    setInterval(sincronizarMinhaEstacao, 5000);
  </script>
</body>
</html>
EOF
