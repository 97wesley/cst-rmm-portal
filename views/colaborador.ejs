  <!-- SCRIPT DE PARTÍCULAS INTERATIVAS (ESTILO NEXTTOOL) + AUTOMAÇÃO RMM -->
  <script>
    // 1. Canvas de Partículas Interativas com o Mouse
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      const ctx = canvas.getContext('2d');
      let width, height, particles = [];
      const mouse = { x: null, y: null, radius: 150 };

      window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });
      window.addEventListener('mouseleave', () => {
        mouse.x = null;
        mouse.y = null;
      });

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        criarParticulas();
      }

      function criarParticulas() {
        const qtd = Math.min(95, Math.floor((width * height) / 14000));
        particles = [];
        for (let i = 0; i < qtd; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.65,
            vy: (Math.random() - 0.5) * 0.65,
            size: Math.random() * 2.2 + 1
          });
        }
      }

      function animar() {
        ctx.clearRect(0, 0, width, height);
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;

          // Interação suave com o cursor do mouse
          if (mouse.x !== null && mouse.y !== null) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < mouse.radius) {
              const force = (mouse.radius - dist) / mouse.radius;
              p.x -= (dx / dist) * force * 1.4;
              p.y -= (dy / dist) * force * 1.4;
            }
          }

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(56, 189, 248, 0.75)';
          ctx.fill();

          for (let j = i + 1; j < particles.length; j++) {
            const p2 = particles[j];
            const dx = p.x - p2.x;
            const dy = p.y - p2.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 130) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = `rgba(99, 102, 241, ${(1 - dist / 130) * 0.35})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }

          if (mouse.x !== null && mouse.y !== null) {
            const dxm = p.x - mouse.x;
            const dym = p.y - mouse.y;
            const distM = Math.sqrt(dxm * dxm + dym * dym);
            if (distM < 160) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.strokeStyle = `rgba(56, 189, 248, ${(1 - distM / 160) * 0.45})`;
              ctx.lineWidth = 1.1;
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(animar);
      }

      window.addEventListener('resize', resize);
      resize();
      animar();
    })();

    // 2. Sincronização automática de estações ativas
    async function atualizarEstacoes() {
      try {
        const res = await fetch('/api/minha-estacao');
        if (!res.ok) return;
        const data = await res.json();
        const select = document.getElementById('select-estacao');
        const badge = document.getElementById('badge-status');
        const texto = document.getElementById('texto-status');
        const atual = select.value;

        if (data.estacoes && data.estacoes.length > 0) {
          select.innerHTML = '';
          data.estacoes.forEach(est => {
            const opt = document.createElement('option');
            opt.value = est.hostname;
            opt.textContent = `${est.hostname} — IP: ${est.ip} (${est.usuario}) ${est.online ? '● Online' : '○ Offline'}`;
            select.appendChild(opt);
          });
          if (atual && Array.from(select.options).some(o => o.value === atual)) {
            select.value = atual;
          } else if (data.alvo) {
            select.value = data.alvo.hostname;
          }

          const selecionada = data.estacoes.find(e => e.hostname === select.value) || data.alvo;
          if (selecionada && selecionada.online) {
            badge.classList.remove('offline');
            texto.textContent = `Agente Online (${selecionada.hostname})`;
          } else {
            badge.classList.add('offline');
            texto.textContent = `Estação Offline (${selecionada ? selecionada.hostname : 'Aguardando'})`;
          }
        }
      } catch (e) {}
    }
    setInterval(atualizarEstacoes, 6000);
    atualizarEstacoes();

    // 3. Execução de comandos com polling em alta performance
    async function executarAcao(acao, titulo) {
      const out = document.getElementById('console-output');
      const meta = document.getElementById('console-meta');
      const hostname = document.getElementById('select-estacao').value || 'AUTO';
      const botoes = document.querySelectorAll('.btn-action');

      botoes.forEach(b => b.disabled = true);
      out.className = 'terminal-output';
      out.textContent = `[INICIANDO] ${titulo}...\nEnviando ordem segura para o agente RMM (${hostname})...`;
      meta.textContent = `Executando: ${titulo}`;

      try {
        const resp = await fetch('/api/comando', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ hostname, acao })
        });
        const dados = await resp.json();

        if (!resp.ok || !dados.ok) {
          out.className = 'terminal-output err';
          out.textContent = `[FALHA] ${dados.erro || 'Não foi possível comunicar com a estação.'}`;
          botoes.forEach(b => b.disabled = false);
          return;
        }

        out.textContent = `[ENVIADO] Comando #${dados.id} recebido pela fila de ${dados.hostname}.\nAguardando resposta do computador...`;

        let tentativas = 0;
        const timer = setInterval(async () => {
          tentativas++;
          try {
            const rCheck = await fetch(`/api/comando/${dados.id}`);
            const statusCmd = await rCheck.json();

            if (statusCmd.concluido) {
              clearInterval(timer);
              botoes.forEach(b => b.disabled = false);
              out.className = statusCmd.sucesso ? 'terminal-output ok' : 'terminal-output err';
              out.textContent = `[CONCLUÍDO às ${statusCmd.finalizadoEm}] ${titulo} (${dados.hostname})\n------------------------------------------------------------\n${statusCmd.saida}`;
              meta.textContent = `Última execução: ${titulo} (${statusCmd.finalizadoEm})`;
            } else if (tentativas >= 25) {
              clearInterval(timer);
              botoes.forEach(b => b.disabled = false);
              out.className = 'terminal-output err';
              out.textContent = `[TEMPO ESGOTADO] O comando foi enviado para ${dados.hostname}, mas o agente Windows demorou mais de 35s para responder.\nVerifique se o serviço do agente CST RMM está rodando nessa máquina.`;
            }
          } catch (errPoll) {}
        }, 1400);
      } catch (err) {
        out.className = 'terminal-output err';
        out.textContent = `[ERRO DE REDE] Falha ao contactar o servidor: ${err.message}`;
        botoes.forEach(b => b.disabled = false);
      }
    }
  </script>

