<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CST TI — Central de Autoatendimento</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-deep: #060914;
      --bg-card: rgba(15, 23, 42, 0.72);
      --bg-card-hover: rgba(22, 34, 62, 0.88);
      --border-glass: rgba(99, 130, 214, 0.22);
      --border-glow: rgba(56, 189, 248, 0.55);
      --primary: #0ea5e9;
      --primary-hover: #0284c7;
      --accent: #6366f1;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-deep);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    #particles-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    .ambient-glow {
      position: fixed;
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(14, 165, 233, 0.14) 0%, rgba(99, 102, 241, 0.06) 45%, transparent 70%);
      top: -180px;
      left: 15%;
      z-index: 0;
      pointer-events: none;
    }

    .wrapper {
      position: relative;
      z-index: 1;
      max-width: 1380px;
      margin: 0 auto;
      padding: 0 24px 60px;
    }

    /* NAVBAR */
    header.navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 28px;
      margin-top: 16px;
      background: rgba(10, 16, 32, 0.78);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 16px;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
      flex-wrap: wrap;
      gap: 14px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-badge {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 16px;
      box-shadow: 0 0 20px rgba(14, 165, 233, 0.4);
    }

    .brand-title { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; }
    .brand-sub { font-size: 12px; color: var(--text-muted); }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-btn {
      text-decoration: none;
      color: var(--text-muted);
      font-size: 13.5px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 10px;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }

    .nav-btn:hover, .nav-btn.active {
      color: #fff;
      background: rgba(14, 165, 233, 0.14);
      border-color: rgba(14, 165, 233, 0.35);
    }

    .user-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .greeting {
      font-size: 14px;
      color: var(--text-muted);
    }
    .greeting strong {
      color: #38bdf8;
      font-weight: 700;
    }

    .btn-logout {
      background: rgba(239, 68, 68, 0.16);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.38);
      padding: 8px 16px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
    }
    .btn-logout:hover {
      background: #ef4444;
      color: #fff;
    }

    /* HERO / STATUS BAR */
    .hero-section {
      margin-top: 28px;
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 20px;
      align-items: center;
    }

    @media (max-width: 960px) {
      .hero-section { grid-template-columns: 1fr; }
    }

    .hero-copy h1 {
      font-size: clamp(26px, 3.2vw, 38px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.03em;
      background: linear-gradient(90deg, #ffffff 0%, #bae6fd 60%, #818cf8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-copy p {
      margin-top: 10px;
      color: var(--text-muted);
      font-size: 15px;
      line-height: 1.55;
      max-width: 600px;
    }

    .station-panel {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 16px;
      padding: 18px 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .station-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .ip-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12.5px;
      background: rgba(14, 165, 233, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #7dd3fc;
      padding: 5px 11px;
      border-radius: 8px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 12.5px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.14);
      color: #6ee7b7;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .status-badge.offline {
      background: rgba(245, 158, 11, 0.14);
      color: #fcd34d;
      border-color: rgba(245, 158, 11, 0.35);
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 8px currentColor;
    }

    .station-select {
      width: 100%;
      background: rgba(6, 11, 25, 0.85);
      color: #f8fafc;
      border: 1px solid var(--border-glass);
      border-radius: 10px;
      padding: 9px 12px;
      font-size: 13.5px;
      font-family: 'Inter', sans-serif;
      outline: none;
    }
    .station-select:focus { border-color: var(--primary); }

    /* GRID DE CATEGORIAS */
    .cards-grid {
      margin-top: 28px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 22px;
    }

    .action-card {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 20px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

    .action-card:hover {
      transform: translateY(-5px);
      background: var(--bg-card-hover);
      border-color: var(--border-glow);
      box-shadow: 0 18px 40px rgba(2, 132, 199, 0.18);
    }

    .card-visual {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }

    .illustration-box {
      width: 74px;
      height: 74px;
      min-width: 74px;
      border-radius: 18px;
      background: linear-gradient(145deg, rgba(14, 165, 233, 0.18), rgba(99, 102, 241, 0.14));
      border: 1px solid rgba(125, 211, 252, 0.28);
      display: grid;
      place-items: center;
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.15), 0 8px 20px rgba(0,0,0,0.35);
    }

    .illustration-box svg {
      width: 48px;
      height: 48px;
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.45));
    }

    .card-visual h2 {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      line-height: 1.25;
    }

    .card-desc {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 18px;
    }

    .btn-stack {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-top: auto;
    }

    .btn-action {
      width: 100%;
      padding: 11px 14px;
      border-radius: 11px;
      border: 1px solid rgba(148, 163, 184, 0.22);
      background: rgba(15, 23, 42, 0.85);
      color: #e2e8f0;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.2s ease;
      text-align: left;
    }

    .btn-action:hover {
      background: rgba(14, 165, 233, 0.2);
      border-color: #38bdf8;
      color: #fff;
      transform: translateX(3px);
    }

    .btn-action.primary-act {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border-color: rgba(125, 211, 252, 0.45);
      color: #fff;
      box-shadow: 0 6px 18px rgba(2, 132, 199, 0.32);
    }

    .btn-action.primary-act:hover {
      background: linear-gradient(135deg, #0ea5e9, #3b82f6);
      box-shadow: 0 8px 24px rgba(14, 165, 233, 0.45);
    }

    .btn-action:disabled {
      opacity: 0.55;
      cursor: wait;
    }

    .tag-cmd {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      padding: 2px 7px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.1);
      color: #bae6fd;
    }

    /* CONSOLE DE EXECUÇÃO */
    .console-card {
      margin-top: 28px;
      background: rgba(9, 14, 28, 0.88);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass);
      border-radius: 18px;
      padding: 22px 26px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .console-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .console-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 700;
    }

    .terminal-output {
      background: #03060f;
      border: 1px solid rgba(56, 189, 248, 0.2);
      border-radius: 12px;
      padding: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      line-height: 1.6;
      color: #38bdf8;
      min-height: 92px;
      max-height: 280px;
      overflow-y: auto;
      white-space: pre-wrap;
    }

    .terminal-output.ok { color: #34d399; border-color: rgba(16, 185, 129, 0.4); }
    .terminal-output.err { color: #f87171; border-color: rgba(239, 68, 68, 0.4); }
  </style>
</head>
<body>
  <canvas id="particles-canvas"></canvas>
  <div class="ambient-glow"></div>

  <div class="wrapper">
    <!-- NAVBAR -->
    <header class="navbar">
      <div class="brand">
        <div class="brand-badge">CST</div>
        <div>
          <div class="brand-title">CST — Central de Autoatendimento TI</div>
          <div class="brand-sub">Automação Inteligente &amp; Suporte Instantâneo</div>
        </div>
      </div>

      <nav class="nav-links">
        <a href="/" class="nav-btn active">Autoatendimento</a>
        <a href="/mais-ti" class="nav-btn">Mais de TI</a>
        <% if (usuario && usuario.perfil === 'admin') { %>
          <a href="/admin" class="nav-btn">Painel Admin</a>
        <% } %>
      </nav>

      <div class="user-area">
        <span class="greeting">Olá, <strong><%= typeof usuario === "object" ? (usuario.login || usuario.usuario || usuario.nome || "Usuário") : usuario %></strong></span>
        <a href="/logout" class="btn-logout">Sair</a>
      </div>
    </header>

    <!-- HERO & ESTAÇÃO -->
    <section class="hero-section">
      <div class="hero-copy">
        <h1>Resolva falhas no seu computador em segundos</h1>
        <p>Execute otimizações remotas, destrave impressoras, renove sua conexão de rede e ajuste o vídeo sem precisar aguardar atendimento técnico.</p>
      </div>

      <div class="station-panel">
        <div class="station-row">
          <span class="ip-pill">Seu IP de Acesso: <strong><%= ipUsuario %></strong></span>
          <span id="badge-status" class="status-badge <%= estacaoAlvo ? '' : 'offline' %>">
            <span class="dot"></span>
            <span id="texto-status"><%= estacaoAlvo ? 'Agente Conectado' : 'Sincronizando Estação...' %></span>
          </span>
        </div>

        <div>
          <label for="select-estacao" style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 5px;">
            Computador Alvo para Execução:
          </label>
          <select id="select-estacao" class="station-select">
            <% if (estacaoAlvo) { %>
              <option value="<%= estacaoAlvo.hostname %>"><%= estacaoAlvo.hostname %> — IP Local: <%= estacaoAlvo.ip %> (<%= estacaoAlvo.usuario %>)</option>
            <% } else { %>
              <option value="AUTO">Detecção Automática (<%= typeof usuario === "object" ? (usuario.login || usuario.usuario || usuario.nome || "Usuário") : usuario %>)</option>
            <% } %>
            <% (estacoes || []).forEach(est => { if (!estacaoAlvo || est.hostname !== estacaoAlvo.hostname) { %>
              <option value="<%= est.hostname %>"><%= est.hostname %> — IP Local: <%= est.ip %> (<%= est.usuario %>)</option>
            <% } }) %>
          </select>
        </div>
      </div>
    </section>

    <!-- 5 CATEGORIAS DE AJUSTES -->
    <main class="cards-grid">

      <!-- 1. TRAVAMENTO E PERFORMANCE -->
      <article class="action-card">
        <div class="card-visual">
          <div class="illustration-box">
            <!-- Ícone 3D Foguete / Performance -->
            <svg viewBox="0 0 64 64" fill="none">
              <defs>
                <linearGradient id="g1" x1="12" y1="8" x2="52" y2="56" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#38BDF8"/>
                  <stop offset="1" stop-color="#6366F1"/>
                </linearGradient>
                <linearGradient id="g1f" x1="20" y1="40" x2="10" y2="54" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#F59E0B"/>
                  <stop offset="1" stop-color="#EF4444"/>
                </linearGradient>
              </defs>
              <path d="M47 9C36 10 25 18 19 29L27 37L35 45C46 39 54 28 55 17C55 12 52 9 47 9Z" fill="url(#g1)"/>
              <circle cx="40" cy="24" r="5" fill="#E0F2FE"/>
              <path d="M19 29L11 32L17 39L27 37L19 29Z" fill="#0284C7"/>
              <path d="M35 45L32 53L25 47L27 37L35 45Z" fill="#4F46E5"/>
              <path d="M21 41C16 43 12 49 11 53C15 52 21 48 23 43L21 41Z" fill="url(#g1f)"/>
            </svg>
          </div>
          <h2>Travamento &amp; Lentidão</h2>
        </div>
        <p class="card-desc">Libera memória, remove arquivos temporários acumulados, otimiza o disco e testa a rota até o servidor.</p>
        <div class="btn-stack">
          <button class="btn-action primary-act" onclick="executarAcao('limpar_temp', 'Limpar Cache do Computador')">
            <span>Limpar Cache do Computador</span>
            <span class="tag-cmd">TEMP</span>
          </button>
          <button class="btn-action" onclick="executarAcao('limpar_navegadores', 'Limpar Cache Chrome, Firefox, Edge e Opera')">
            <span>Cache Chrome / Firefox / Edge / Opera</span>
            <span class="tag-cmd">BROWSERS</span>
          </button>
          <button class="btn-action" onclick="executarAcao('otimizar_disco', 'Otimizar e Limpar Disco')">
            <span>Otimizar Disco (Trim / Defrag)</span>
            <span class="tag-cmd">DISCO</span>
          </button>
          <button class="btn-action" onclick="executarAcao('tracert_servidor', 'Rastrear Rota até o Servidor (Tracert)')">
            <span>Tracert Rota ao Servidor</span>
            <span class="tag-cmd">ROTA</span>
          </button>
        </div>
      </article>

      <!-- 2. IMPRESSORAS -->
      <article class="action-card">
        <div class="card-visual">
          <div class="illustration-box">
            <!-- Ícone 3D Impressora -->
            <svg viewBox="0 0 64 64" fill="none">
              <defs>
                <linearGradient id="g2" x1="10" y1="16" x2="54" y2="50" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#34D399"/>
                  <stop offset="1" stop-color="#0284C7"/>
                </linearGradient>
              </defs>
              <rect x="18" y="10" width="28" height="14" rx="3" fill="#BAE6FD"/>
              <rect x="8" y="22" width="48" height="22" rx="6" fill="url(#g2)"/>
              <circle cx="48" cy="29" r="2.5" fill="#FEF08A"/>
              <rect x="18" y="36" width="28" height="18" rx="3" fill="#F8FAFC"/>
              <line x1="23" y1="42" x2="41" y2="42" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
              <line x1="23" y1="48" x2="36" y2="48" stroke="#94A3B8" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h2>Impressoras &amp; Fila</h2>
        </div>
        <p class="card-desc">Destrava documentos parados na fila, reinicia o serviço de spooler e diagnostica impressoras instaladas.</p>
        <div class="btn-stack">
          <button class="btn-action primary-act" onclick="executarAcao('reiniciar_spooler', 'Reiniciar Spooler de Impressão')">
            <span>Reiniciar Spooler &amp; Destravar</span>
            <span class="tag-cmd">SPOOLER</span>
          </button>
          <button class="btn-action" onclick="executarAcao('listar_impressoras', 'Listar Impressoras Instaladas')">
            <span>Listar Impressoras da Estação</span>
            <span class="tag-cmd">LISTA</span>
          </button>
          <button class="btn-action" onclick="executarAcao('limpar_fila_impressao', 'Limpar Documentos Presos na Fila')">
            <span>Limpar Fila de Impressão</span>
            <span class="tag-cmd">FILA</span>
          </button>
          <button class="btn-action" onclick="executarAcao('pagina_teste_impressora', 'Enviar Página de Teste')">
            <span>Imprimir Página de Teste</span>
            <span class="tag-cmd">TESTE</span>
          </button>
        </div>
      </article>

      <!-- 3. REDE E CONECTIVIDADE -->
      <article class="action-card">
        <div class="card-visual">
          <div class="illustration-box">
            <!-- Ícone 3D Globo / Rede -->
            <svg viewBox="0 0 64 64" fill="none">
              <defs>
                <linearGradient id="g3" x1="10" y1="10" x2="54" y2="54" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#38BDF8"/>
                  <stop offset="1" stop-color="#3B82F6"/>
                </linearGradient>
              </defs>
              <circle cx="32" cy="32" r="22" fill="url(#g3)" fill-opacity="0.25" stroke="#38BDF8" stroke-width="3"/>
              <ellipse cx="32" cy="32" rx="10" ry="22" stroke="#7DD3FC" stroke-width="2.5"/>
              <line x1="10" y1="32" x2="54" y2="32" stroke="#7DD3FC" stroke-width="2.5"/>
              <circle cx="46" cy="18" r="5" fill="#10B981"/>
              <circle cx="18" cy="46" r="4" fill="#6366F1"/>
            </svg>
          </div>
          <h2>Rede &amp; Internet</h2>
        </div>
        <p class="card-desc">Restabelece o acesso a sistemas internos, limpa registros antigos de DNS e renova o IP da placa de rede.</p>
        <div class="btn-stack">
          <button class="btn-action primary-act" onclick="executarAcao('limpar_dns', 'Limpar Cache DNS (FlushDNS)')">
            <span>Limpar Cache DNS</span>
            <span class="tag-cmd">DNS</span>
          </button>
          <button class="btn-action" onclick="executarAcao('renovar_ip', 'Renovar Endereço IP (Release/Renew)')">
            <span>Renovar IP da Rede</span>
            <span class="tag-cmd">DHCP</span>
          </button>
          <button class="btn-action" onclick="executarAcao('ping_google', 'Teste de Ping 8.8.8.8')">
            <span>Teste de Ping (8.8.8.8)</span>
            <span class="tag-cmd">PING</span>
          </button>
          <button class="btn-action" onclick="executarAcao('reset_winsock', 'Resetar Adaptador & Winsock')">
            <span>Reparar Pilha de Rede (Winsock)</span>
            <span class="tag-cmd">REPARO</span>
          </button>
        </div>
      </article>

      <!-- 4. ATUALIZAÇÕES E POLÍTICAS -->
      <article class="action-card">
        <div class="card-visual">
          <div class="illustration-box">
            <!-- Ícone 3D Escudo / Atualização -->
            <svg viewBox="0 0 64 64" fill="none">
              <defs>
                <linearGradient id="g4" x1="14" y1="8" x2="50" y2="56" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#818CF8"/>
                  <stop offset="1" stop-color="#C084FC"/>
                </linearGradient>
              </defs>
              <path d="M32 8L12 16V31C12 44.5 20.5 55.8 32 59C43.5 55.8 52 44.5 52 31V16L32 8Z" fill="url(#g4)"/>
              <path d="M23 32L29 38L42 25" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2>Atualização &amp; AD</h2>
        </div>
        <p class="card-desc">Verifica pacotes pendentes do Windows, sincroniza permissões do servidor e ajusta o relógio corporativo.</p>
        <div class="btn-stack">
          <button class="btn-action primary-act" onclick="executarAcao('atualizar_gpo', 'Atualizar Políticas do Servidor (GPUpdate)')">
            <span>Atualizar GPO (Permissões AD)</span>
            <span class="tag-cmd">GPO</span>
          </button>
          <button class="btn-action" onclick="executarAcao('verificar_windows_update', 'Verificar Atualizações do Windows')">
            <span>Verificar Atualizações Windows</span>
            <span class="tag-cmd">UPDATE</span>
          </button>
