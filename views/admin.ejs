<script>
function tab(id,b){document.querySelectorAll(".pane").forEach(p=>p.classList.remove("active"));document.querySelectorAll(".tbtn").forEach(x=>x.classList.remove("active"));document.getElementById("p-"+id).classList.add("active");b.classList.add("active");}
async function loadRede(){try{const r=await fetch("/api/admin/inventario");const d=await r.json();const rows=[];(d.estacoes||[]).forEach(e=>rows.push("<tr><td><a class='hlink' target='_blank' href='/admin/maquina/"+encodeURIComponent(e.hostname)+"'>🖥️ "+e.hostname+" ↗</a></td><td style='font-size:11px;color:#94a3b8'>"+(e.entidade||"CST")+"</td><td><span class='"+(e.online?"on":"off")+"'>"+(e.online?"Online":"Offline")+"</span></td><td>"+(e.tipoSistema||"Windows")+"</td><td><b>"+(e.usuario||"N/D")+"</b></td><td><b>"+(e.ram_total||"16GB")+" ("+(e.ram_uso||0)+"% uso)</b></td><td><b>"+e.ssdInfo+"</b></td><td><b>"+(e.ip||"N/D")+"</b></td><td>CPU "+(e.cpu_uso||0)+"%</td></tr>"));(d.switches||[]).forEach(s=>rows.push("<tr><td><a class='hlink' target='_blank' href='/admin/maquina/"+encodeURIComponent(s.hostname)+"'>🔀 "+s.hostname+" ↗</a></td><td>REDE</td><td><span class='on'>Online</span></td><td>"+s.sistema+"</td><td>Switch</td><td>—</td><td><b>"+s.ssd+"</b></td><td><b>"+s.ip+"</b></td><td>"+s.infoExtra+"</td></tr>"));document.getElementById("tbRede").innerHTML=rows.join("");}catch(e){}}
const svgEx=t=>"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='400'><rect width='100%' height='100%' fill='%230f172a'/><text x='50%' y='50%' fill='%2338bdf8' font-size='24' font-family='sans-serif' text-anchor='middle'>"+encodeURIComponent(t)+"</text></svg>";
let ativos=[
  {colab:"Exemplo 1 • Wesley Lima (GC-M08-PC0085)",setor:"TI • VLAN 102",gab:{p:"CST-1042",m:"Dell OptiPlex",f:svgEx("Gabinete CST-1042")},mon1:{p:"CST-2011",m:"LG 24 FHD",f:svgEx("Monitor 1 CST-2011")},mon2:{p:"CST-2012",m:"LG 24 FHD",f:svgEx("Monitor 2 CST-2012")},tec:{p:"CST-3088",m:"Logitech MK270",f:svgEx("Teclado/Mouse CST-3088")},head:{p:"CST-4015",m:"Jabra Evolve",f:svgEx("Headset CST-4015")},cel:{p:"CST-5009",m:"Samsung A54",f:svgEx("Celular CST-5009")}},
  {colab:"Exemplo 2 • Atendimento Comercial",setor:"Comercial • VLAN 105",gab:{p:"CST-1099",m:"Lenovo ThinkCentre",f:svgEx("Gabinete CST-1099")},mon1:{p:"CST-2055",m:"Samsung 22",f:svgEx("Monitor 1 CST-2055")},mon2:{p:"S/N",m:"Não possui",f:""},tec:{p:"CST-3102",m:"Dell KB216",f:svgEx("Kit CST-3102")},head:{p:"CST-4077",m:"Logitech H390",f:svgEx("Headset CST-4077")},cel:{p:"CST-5021",m:"Moto G54",f:svgEx("Celular CST-5021")}}
];
function ver4k(src,txt){document.getElementById("i4k").src=src;document.getElementById("l4k").textContent=txt;document.getElementById("m4k").style.display="flex";}
function cell(o,n){if(!o||(!o.p&&!o.m))return"—";const img=o.f?"<img src=\""+o.f+"\" class=\"thumb\" onclick=\"ver4k('"+o.f+"','"+n+" • Pat: "+o.p+"')\">":"";return "<div style='display:flex;gap:8px;align-items:center'>"+img+"<div><b style='color:#38bdf8'>Pat: "+o.p+"</b><br><small style='color:#94a3b8'>"+o.m+"</small></div></div>";}
function renderAtivos(){document.getElementById("tbAtivos").innerHTML=ativos.map(a=>"<tr><td><b>"+a.colab+"</b><br><small style='color:#94a3b8'>"+a.setor+"</small></td><td>"+cell(a.gab,"Gabinete")+"</td><td>"+cell(a.mon1,"Monitor 1")+"</td><td>"+cell(a.mon2,"Monitor 2")+"</td><td>"+cell(a.tec,"Teclado/Mouse")+"</td><td>"+cell(a.head,"Headset")+"</td><td>"+cell(a.cel,"Celular")+"</td></tr>").join("");}
const lerF=id=>new Promise(r=>{const f=document.getElementById(id).files[0];if(!f)return r("");const rd=new FileReader();rd.onload=()=>r(rd.result);rd.readAsDataURL(f);});
async function addAtivo(){
  ativos.unshift({
    colab:document.getElementById("cColab").value||"Novo Colaborador",setor:document.getElementById("cSetor").value||"VLAN 102",
    gab:{p:document.getElementById("pGab").value,m:document.getElementById("mGab").value,f:await lerF("fGab")},
    mon1:{p:document.getElementById("pMon1").value,m:document.getElementById("mMon1").value,f:await lerF("fMon1")},
    mon2:{p:document.getElementById("pMon2").value,m:document.getElementById("mMon2").value,f:await lerF("fMon2")},
    tec:{p:document.getElementById("pTec").value,m:document.getElementById("mTec").value,f:await lerF("fTec")},
    head:{p:document.getElementById("pHead").value,m:document.getElementById("mHead").value,f:await lerF("fHead")},
    cel:{p:document.getElementById("pCel").value,m:document.getElementById("mCel").value,f:await lerF("fCel")}
  });
  renderAtivos();
}
loadRede();renderAtivos();setInterval(loadRede,5000);
</script>
<script>
setInterval(async () => {
  try {
    const r = await fetch("/api/net2phone/status");
    const d = await r.json();
    const tit = Array.from(document.querySelectorAll("*")).find(el => el.textContent && el.textContent.includes("Usuários em Atendimento ao Vivo (net2phone)") && el.children.length === 0);
    if (tit) {
      const card = tit.closest("div");
      const tbody = card ? card.querySelector("tbody") : null;
      if (tbody) {
        if (d.ativas.length === 0) {
          tbody.innerHTML = "<tr><td colspan=\"4\" style=\"text-align:center;color:#94a3b8;padding:16px;\">0/20 chamadas ativas no momento (Sync 3s)</td></tr>";
        } else {
          tbody.innerHTML = d.ativas.map(c => `<tr><td><b>${c.ramal}</b></td><td>${c.destino}</td><td><span style="color:#38bdf8;">${c.direcao}</span></td><td><span style="color:#4ade80;font-weight:bold;">● ${c.status}</span></td></tr>`).join("");
        }
      }
    }
    const titHist = Array.from(document.querySelectorAll("*")).find(el => el.textContent && el.textContent.includes("Histórico & Eventos net2phone") && el.children.length === 0);
    if (titHist && d.historico) {
      const cardH = titHist.closest("div");
      const tbodyH = cardH ? cardH.querySelector("tbody") : null;
      if (tbodyH && d.historico.length > 0) {
        tbodyH.innerHTML = d.historico.map(h => `<tr><td>${h.horario}</td><td>${h.evento}</td><td>${h.detalhes}</td></tr>`).join("");
      }
    }
  } catch (e) {}
}, 3000);
</script>

