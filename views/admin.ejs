.off{background:#fee2e2;color:#b91c1c;padding:3px 10px;border-radius:99px;font-weight:700;font-size:11.5px}
.grid-at{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:12px;margin:12px 0}
.box-at{background:#090f1d;border:1px solid #1e293b;padding:12px;border-radius:10px}
input{background:#080d18;border:1px solid #26354f;color:#fff;padding:8px 10px;border-radius:7px;font-size:12.5px;width:100%;margin-bottom:6px}
.btn{background:#0284c7;color:#fff;border:none;padding:9px 16px;border-radius:8px;font-weight:700;cursor:pointer}
.thumb{width:46px;height:46px;object-fit:cover;border-radius:6px;cursor:zoom-in;border:1px solid #38bdf8}
#m4k{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:999;justify-content:center;align-items:center;flex-direction:column}
#m4k img{max-width:94vw;max-height:86vh;border-radius:10px}
</style></head><body>
