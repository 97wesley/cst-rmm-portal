<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Painel RMM Administrador - CST</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0b131e; color: #e2e8f0; }

        .admin-header { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 12px 25px; display: flex; justify-content: space-between; align-items: center; color: #1e293b; }
        .nav-tabs { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; }
        .tab-btn { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 6px; cursor: pointer; text-decoration: none; color: #475569; }
        .tab-btn:hover, .tab-btn.active { background: #e0f2fe; color: #0284c7; }

        .header-actions { display: flex; align-items: center; gap: 10px; }
        .btn-sair { background: #ef4444; color: white; text-decoration: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; font-size: 13px; }

        .container { padding: 25px; }

        /* Tabela RMM */
        .card-table { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow-x: auto; color: #1e293b; }
        table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
        th { background: #ffffff; color: #0f172a; font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 14px 16px; border-bottom: 2px solid #e2e8f0; }
        td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; font-size: 13px; color: #334155; }
        
        .badge-online { background: #dcfce7; color: #15803d; border: 1px solid #86efac; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; }
        .badge-offline { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; }
        
        /* Botões de Comando Admin na Tabela */
        .btn-cmd { background: #0284c7; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 11px; font-weight: 600; margin-right: 4px; }
        .btn-cmd:hover { background: #0369a1; }
        .btn-cmd.danger { background: #ef4444; }
        .btn-cmd.danger:hover { background: #b91c1c; }

        /* =========================================================
           ESTILOS TELEFONIA IP & TARJA DA CENTRAL COM ÍCONE 3D
           ========================================================= */
        .pbx-banner-container {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 20px 25px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5);
        }

        .pbx-info-side { display: flex; align-items: center; gap: 20px; }
        
        /* Efeito 3D CSS para o Servidor da Central */
        .pbx-3d-stage { width: 55px; height: 55px; perspective: 600px; }
        .pbx-3d-box {
            width: 100%; height: 100%; position: relative; transform-style: preserve-3d;
            animation: spin3d 10s infinite linear;
        }
        @keyframes spin3d {
            0% { transform: rotateX(-15deg) rotateY(0deg); }
            100% { transform: rotateX(-15deg) rotateY(360deg); }
        }
        
        .cube-face {
            position: absolute; width: 55px; height: 55px; border: 2px solid;
            display: flex; align-items: center; justify-content: center; font-size: 20px;
            border-radius: 8px; opacity: 0.9;
        }
        
        /* Cores Dinâmicas 3D (Online vs Offline) */
        .online-3d .cube-face { background: rgba(34, 197, 94, 0.2); border-color: #22c55e; color: #4ade80; box-shadow: 0 0 15px rgba(34, 197, 94, 0.4); }
        .offline-3d .cube-face { background: rgba(239, 68, 68, 0.3); border-color: #ef4444; color: #fca5a5; box-shadow: 0 0 25px rgba(239, 68, 68, 0.8); animation: pulseDanger 1.2s infinite; }
        
        @keyframes pulseDanger { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }

        .pbx-details h3 { font-size: 18px; color: #f8fafc; margin-bottom: 4px; display: flex; align-items: center; gap: 10px; }
        .pbx-details p { font-size: 13px; color: #94a3b8; }
        .pbx-details span.ip-highlight { color: #38bdf8; font-weight: 700; font-family: monospace; font-size: 15px; }

        .pbx-metrics-side { display: flex; gap: 20px; text-align: right; }
        .pbx-metric-item label { display: block; font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase; }
        .pbx-metric-item val { font-size: 15px; font-weight: 800; color: #38bdf8; }

        /* Grid Inferior Telefonia */
        .tel-bottom-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-top: 20px; }
        .dark-panel { background: #111827; border: 1px solid #1f2937; border-radius: 8px; padding: 20px; color: #f3f4f6; }
        .dark-panel h4 { color: #38bdf8; font-size: 14px; border-bottom: 1px solid #1f2937; padding-bottom: 10px; margin-bottom: 15px; display: flex; align-items: center; justify-content: space-between; }
        
        /* Barras por Setor */
        .sector-row { margin-bottom: 12px; }
        .sector-info { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
        .sector-bar-bg { background: #1f2937; border-radius: 6px; height: 10px; overflow: hidden; }
        .sector-bar-fill { background: #0284c7; height: 100%; border-radius: 6px; }

        /* Log de Eventos */
        .event-log-item { font-size: 12px; padding: 8px 10px; border-left: 3px solid #0284c7; background: #1a2436; margin-bottom: 8px; border-radius: 4px; }
        .event-log-item.danger { border-left-color: #ef4444; background: #2d181e; }
        .event-log-item .time { color: #94a3b8; font-size: 11px; margin-right: 6px; }

        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>

    <!-- Header do Administrador -->
    <header class="admin-header">
        <div class="nav-tabs">
            <a href="#" class="tab-btn active" onclick="trocarSecao('sec-computadores', this)"><i class="fa-solid fa-desktop" style="color: #0284c7;"></i> 💻 Computador (RMM 5s)</a>
            <a href="#" class="tab-btn" onclick="trocarSecao('sec-ativos', this)"><i class="fa-solid fa-folder" style="color: #f59e0b;"></i> 📁 Ativos & Inventário</a>
            <a href="#" class="tab-btn" onclick="trocarSecao('sec-telefonia', this)"><i class="fa-solid fa-phone" style="color: #10b981;"></i> 📞 Telefonia IP & Ramais</a>
        </div>

        <div class="header-actions">
            <span style="font-size: 13px; font-weight: 700; margin: 0 10px;"><%= usuario %> (TI)</span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </header>

    <div class="container">
        
        <!-- SEÇÃO 1: RMM COMPUTADORES (COM SINCRONIZAÇÃO A CADA 5 SEG E COMANDOS DIRECTS) -->
        <div id="sec-computadores" class="tab-content active">
            <div style="margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; color: #fff;">
                <h3>💻 Estações de Trabalho Registradas</h3>
                <span style="font-size: 12px; color: #34d399;"><i class="fa-solid fa-sync fa-spin"></i> Auto-sincronizando a cada 5s</span>
            </div>
            
            <div class="card-table">
                <table>
                    <thead>
                        <tr>
                            <th>NOME</th><th>ENTIDADE</th><th>STATUS</th><th>TIPO</th><th>NOME ALTERNATIVO DO USUÁRIO</th>
                            <th>PROCESSADOR</th><th>MEMÓRIA</th><th>DISCO</th><th>CONECTIVIDADE IP</th><th>ÚLTIMA ATUALIZAÇÃO</th><th>AÇÕES DE TI</th>
                        </tr>
                    </thead>
                    <tbody id="tbComputadoresRmm">
                        <% estacoes.forEach(function(maq) { 
                            const isOnline = (new Date() - new Date(maq.ultimaVez)) < 35000;
                        %>
                            <tr>
                                <td><strong>💻 <%= maq.hostname %></strong></td>
                                <td><%= maq.entidade || 'Entidade raiz > CST' %></td>
                                <td><span class="<%= isOnline ? 'badge-online' : 'badge-offline' %>"><%= isOnline ? 'Online' : 'Offline' %></span></td>
                                <td><%= maq.tipo || 'Desktop' %></td>
                                <td><%= maq.usuario %></td>
                                <td><%= maq.processador || 'Intel / AMD' %></td>
                                <td><strong><%= maq.ram_total || '8 GB' %></strong> (<%= maq.ram %>% uso)</td>
                                <td><%= maq.disco %>% uso</td>
                                <td><strong><%= maq.ip %></strong></td>
                                <td style="color: #64748b;"><%= new Date(maq.ultimaVez).toLocaleTimeString() %></td>
                                <td>
                                    <button class="btn-cmd" onclick="enviarComandoRemoto('<%= maq.hostname %>', 'limpar_cache')">🧹 Cache</button>
                                    <button class="btn-cmd" onclick="enviarComandoRemoto('<%= maq.hostname %>', 'destravar_impressora')">🔄 Spooler</button>
                                    <button class="btn-cmd" onclick="enviarComandoRemoto('<%= maq.hostname %>', 'flush_dns')">🌐 FlushDNS</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SEÇÃO 2: ATIVOS -->
        <div id="sec-ativos" class="tab-content">
            <div style="background: #fff; padding: 25px; border-radius: 8px; color: #1e293b;">
                <h3>📁 Gestão de Ativos CST</h3>
                <p style="color: #64748b;">Módulo de inventário de hardware.</p>
            </div>
        </div>

        <!-- SEÇÃO 3: TELEFONIA IP COM TARJA 3D E CONTEÚDO EXPANDIDO NO RODAPÉ -->
        <div id="sec-telefonia" class="tab-content">
            
            <!-- TARJA DE STATUS DA CENTRAL IP COM ANIMAÇÃO 3D -->
            <div class="pbx-banner-container" id="pbxBanner">
                <div class="pbx-info-side">
                    <!-- Servidor 3D Animado em CSS -->
                    <div class="pbx-3d-stage">
                        <div class="pbx-3d-box online-3d" id="cube3d">
                            <div class="cube-face"><i class="fa-solid fa-server"></i></div>
                        </div>
                    </div>
                    
                    <div class="pbx-details">
                        <h3>
                            <span id="txtNomeCentral">Central PABX IP - Intelbras Impacta 300 ICIP</span> 
                            <span id="badgeCentralStatus" class="badge-online">100% OPERACIONAL</span>
                        </h3>
                        <p>Endereço IP da Central: <span class="ip-highlight" id="txtIpCentral">192.168.102.1</span> | Uptime: <strong id="txtUptimeCentral" style="color: #f8fafc;">15 dias, 04 horas</strong></p>
                    </div>
                </div>

                <div class="pbx-metrics-side">
                    <div class="pbx-metric-item">
                        <label>Tráfego RX / TX</label>
                        <val id="txtTrafego">12.4 / 8.7 Mbps</val>
                    </div>
                    <div class="pbx-metric-item">
                        <label>Perda de Pacotes</label>
                        <val style="color: #22c55e;" id="txtPerda">0.0%</val>
                    </div>
                    <div class="pbx-metric-item">
                        <label>Jitter Médio</label>
                        <val style="color: #38bdf8;" id="txtJitter">1.2 ms</val>
                    </div>
                    <button onclick="alternarStatusCentralSimulacao()" style="background: #3b82f6; color: #fff; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold;">
                        🔄 Testar Sinal da Central
                    </button>
                </div>
            </div>

            <!-- Tabela de Ramais IP -->
            <div style="background: #111827; border: 1px solid #1f2937; border-radius: 8px; padding: 20px; color: #f3f4f6; margin-bottom: 20px;">
                <h4 style="color: #38bdf8; font-size: 15px; margin-bottom: 15px;">📞 Ramais Registrados no PABX (Ping a cada 5s)</h4>
                <table style="width: 100%; color: #e5e7eb;">
                    <thead>
                        <tr style="background: #1f2937; color: #9ca3af;">
                            <th>RAMAL</th><th>COLABORADOR / SETOR</th><th>IP DO RAMAL</th><th>MAC ADDRESS</th><th>STATUS</th><th>LATÊNCIA (PING)</th><th>AÇÃO TESTE</th>
                        </tr>
                    </thead>
                    <tbody id="tbRamaisCorpo">
                        <!-- Preenchido via JS -->
                    </tbody>
                </table>
            </div>

            <!-- PREENCHIMENTO DO MEIO ATÉ O RODAPÉ (CONTEÚDO DERSO DA TELEFONIA) -->
            <div class="tel-bottom-grid">
                
                <!-- Coluna 1: Distribuição de Ramais por Setor -->
                <div class="dark-panel">
                    <h4>📊 Ramais por Setor</h4>
                    <div class="sector-row">
                        <div class="sector-info"><span>Financeiro</span><span>10 Ramais (100% OK)</span></div>
                        <div class="sector-bar-bg"><div class="sector-bar-fill" style="width: 100%;"></div></div>
                    </div>
                    <div class="sector-row">
                        <div class="sector-info"><span>Recepção</span><span>8 Ramais (100% OK)</span></div>
                        <div class="sector-bar-bg"><div class="sector-bar-fill" style="width: 100%;"></div></div>
                    </div>
                    <div class="sector-row">
                        <div class="sector-info"><span>Coordenação Médica</span><span>8 Ramais (100% OK)</span></div>
                        <div class="sector-bar-bg"><div class="sector-bar-fill" style="width: 100%;"></div></div>
                    </div>
                    <div class="sector-row">
                        <div class="sector-info"><span>Comercial</span><span>7 Ramais (87.5% OK)</span></div>
                        <div class="sector-bar-bg"><div class="sector-bar-fill" style="width: 87.5%; background: #f59e0b;"></div></div>
                    </div>
                    <div class="sector-row">
                        <div class="sector-info"><span>TI / Suporte</span><span>7 Ramais (100% OK)</span></div>
                        <div class="sector-bar-bg"><div class="sector-bar-fill" style="width: 100%;"></div></div>
                    </div>
                </div>

                <!-- Coluna 2: Feed de Eventos SIP em Tempo Real -->
                <div class="dark-panel">
                    <h4>⚡ Live Log de Eventos SIP</h4>
                    <div id="containerEventosLog">
                        <!-- Preenchido via JS -->
                    </div>
                </div>

                <!-- Coluna 3: Painel de Controle e Chamadas Ativas -->
                <div class="dark-panel">
                    <h4>📞 Ligações em Andamento Agora</h4>
                    <div id="containerChamadasAtivas">
                        <!-- Preenchido via JS -->
                    </div>
                </div>

            </div>

        </div>

    </div>

    <script>
        function trocarSecao(secaoId, elemento) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(secaoId).classList.add('active');
            elemento.classList.add('active');
            if (secaoId === 'sec-telefonia') carregarTelefonia();
        }

        // --- SINCRONIZAÇÃO A CADA 5 SEGUNDOS DOS COMPUTADORES RMM ---
        async function sincronizarComputadoresRMM() {
            try {
                const res = await fetch('/api/v1/rmm-metrics');
                const dados = await res.json();
                const tbody = document.getElementById('tbComputadoresRmm');
                
                if (!tbody) return;

                let html = '';
                dados.forEach(maq => {
                    const isOnline = (new Date() - new Date(maq.ultimaVez)) < 35000;
                    html += `
                        <tr>
                            <td><strong>💻 ${maq.hostname}</strong></td>
                            <td>${maq.entidade || 'Entidade raiz > CST'}</td>
                            <td><span class="${isOnline ? 'badge-online' : 'badge-offline'}">${isOnline ? 'Online' : 'Offline'}</span></td>
                            <td>${maq.tipo || 'Desktop'}</td>
                            <td>${maq.usuario}</td>
                            <td>${maq.processador || 'Intel / AMD'}</td>
                            <td><strong>${maq.ram_total || '8 GB'}</strong> (${maq.ram}% uso)</td>
                            <td>${maq.disco}% uso</td>
                            <td><strong>${maq.ip}</strong></td>
                            <td style="color: #64748b;">${new Date(maq.ultimaVez).toLocaleTimeString()}</td>
                            <td>
                                <button class="btn-cmd" onclick="enviarComandoRemoto('${maq.hostname}', 'limpar_cache')">🧹 Cache</button>
                                <button class="btn-cmd" onclick="enviarComandoRemoto('${maq.hostname}', 'destravar_impressora')">🔄 Spooler</button>
                                <button class="btn-cmd" onclick="enviarComandoRemoto('${maq.hostname}', 'flush_dns')">🌐 FlushDNS</button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch (e) {
                console.error("Erro ao sincronizar RMM", e);
            }
        }

        async function enviarComandoRemoto(hostname, acao) {
            if (!confirm(`Enviar comando [${acao}] para a máquina ${hostname}?`)) return;
            await fetch('/api/v1/executar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hostname, acao })
            });
            alert("Comando enfileirado com sucesso!");
        }

        // --- SINCRONIZAÇÃO DA TELEFONIA EM TEMPO REAL ---
        async function carregarTelefonia() {
            try {
                const res = await fetch('/api/v1/telefonia/metrics');
                const dados = await res.json();

                // 1. Atualiza Tarja da Central com Ícone 3D
                const cube = document.getElementById('cube3d');
                const badge = document.getElementById('badgeCentralStatus');
                
                if (dados.central.online) {
                    cube.className = 'pbx-3d-box online-3d';
                    badge.className = 'badge-online';
                    badge.innerText = '100% OPERACIONAL';
                } else {
                    cube.className = 'pbx-3d-box offline-3d';
                    badge.className = 'badge-offline';
                    badge.innerText = '⚠️ CENTRAL FORA DO AR';
                }

                document.getElementById('txtIpCentral').innerText = dados.central.ip;
                document.getElementById('txtUptimeCentral').innerText = dados.central.uptime;
                document.getElementById('txtTrafego').innerText = `${dados.central.trafegoRx} / ${dados.central.trafegoTx}`;
                document.getElementById('txtPerda').innerText = dados.central.perdaPacotes;
                document.getElementById('txtJitter').innerText = dados.central.jitterMdio;

                // 2. Tabela de Ramais
                let htmlTb = '';
                dados.ramais.forEach(r => {
                    const statusBadge = r.status === 'Online' 
                        ? (r.emChamada ? '<span style="background:#0284c7; color:#fff; padding:2px 6px; border-radius:10px; font-size:10px; font-weight:bold;">📞 EM CHAMADA</span>' : '<span class="badge-online">🟢 Online</span>')
                        : '<span class="badge-offline">🔴 Offline</span>';

                    const lat = r.status === 'Online' ? `<strong style="color:#34d399;">${r.latencia} ms</strong>` : '<span style="color:#ef4444;">Timeout</span>';

                    htmlTb += `
                        <tr>
                            <td style="font-weight:bold; color:#38bdf8;">${r.ramal}</td>
                            <td>${r.nome}</td>
                            <td><strong style="color:#60a5fa;">${r.ip}</strong></td>
                            <td style="font-size:11px; color:#9ca3af;">${r.mac}</td>
                            <td>${statusBadge}</td>
                            <td>${lat}</td>
                            <td>
                                ${r.status === 'Online' ? `<button onclick="simularQuedaRamal('${r.ramal}')" style="background:#ef4444; color:#fff; border:none; padding:3px 6px; border-radius:4px; cursor:pointer; font-size:10px;">Queda (E-mail)</button>` : '<span style="color:#9ca3af; font-size:10px;">Offline</span>'}
                            </td>
                        </tr>
                    `;
                });
                document.getElementById('tbRamaisCorpo').innerHTML = htmlTb;

                // 3. Log de Eventos
                let htmlLog = '';
                dados.eventos.forEach(ev => {
                    htmlLog += `
                        <div class="event-log-item ${ev.tipo === 'danger' ? 'danger' : ''}">
                            <span class="time">${ev.hora}</span> ${ev.texto}
                        </div>
                    `;
                });
                document.getElementById('containerEventosLog').innerHTML = htmlLog;

                // 4. Chamadas Ativas
                let htmlChamadas = '';
                dados.chamadas.forEach(c => {
                    htmlChamadas += `
                        <div style="background:#1f2937; border-left:4px solid #3b82f6; padding:10px; margin-bottom:8px; border-radius:4px; font-size:12px;">
                            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                <span style="font-weight:bold; color:#60a5fa;">${c.status}</span>
                                <span style="color:#9ca3af;">⏱️ ${c.duracao}</span>
                            </div>
                            <div style="color:#fff;">${c.origem}</div>
                            <div style="color:#9ca3af;">➡️ ${c.destino}</div>
                        </div>
                    `;
                });
                document.getElementById('containerChamadasAtivas').innerHTML = htmlChamadas;

            } catch (e) {
                console.error("Erro na telefonia", e);
            }
        }

        async function alternarStatusCentralSimulacao() {
            await fetch('/api/v1/telefonia/alternar-central', { method: 'POST' });
            carregarTelefonia();
        }

        async function simularQuedaRamal(ramal) {
            if (!confirm(`Simular queda no ramal ${ramal} e disparar alerta de e-mail para ti@cstbh.com.br?`)) return;
            await fetch('/api/v1/telefonia/simular-queda', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ramal })
            });
            alert("Sinal de queda gerado! E-mail enviado.");
            carregarTelefonia();
        }

        // --- LOOPS AUTOMÁTICOS ---
        setInterval(sincronizarComputadoresRMM, 5000); // 5 segundos para a frota RMM
        setInterval(() => {
            const secTel = document.getElementById('sec-telefonia');
            if (secTel && secTel.classList.contains('active')) carregarTelefonia();
        }, 3000); // 3 segundos para Telefonia
    </script>
</body>
</html>
