<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Painel RMM Administrador - CST</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0b131e; color: #1e293b; }

        .admin-header { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 12px 25px; display: flex; justify-content: space-between; align-items: center; }
        .nav-tabs { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; }
        .tab-btn { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 6px; cursor: pointer; text-decoration: none; color: #475569; }
        .tab-btn:hover, .tab-btn.active { background: #e0f2fe; color: #0284c7; }

        .header-actions { display: flex; align-items: center; gap: 10px; }
        .btn-bi { background: #3b82f6; color: white; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; }
        .btn-add { background: #f59e0b; color: white; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; }
        .btn-sair { background: #ef4444; color: white; text-decoration: none; padding: 8px 14px; border-radius: 6px; font-weight: 700; font-size: 13px; }

        .container { padding: 25px; }

        .card-table { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
        th { background: #ffffff; color: #0f172a; font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 14px 16px; border-bottom: 2px solid #e2e8f0; }
        td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; font-size: 13px; color: #334155; }
        
        .badge-online { background: #dcfce7; color: #15803d; border: 1px solid #86efac; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; }
        .badge-offline { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; }
        .badge-call { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.6; } 100% { opacity: 1; } }

        /* Estilos da Telefonia IP */
        .telefonia-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 15px; margin-bottom: 20px; }
        .kpi-box { background: #111827; border: 1px solid #1f2937; border-radius: 8px; padding: 15px; color: #fff; text-align: center; }
        .kpi-title { font-size: 11px; color: #9ca3af; margin-bottom: 5px; font-weight: 600; text-transform: uppercase; }
        .kpi-value { font-size: 22px; font-weight: 800; }
        
        .tel-dashboard { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        .dark-card { background: #111827; border: 1px solid #1f2937; border-radius: 8px; padding: 20px; color: #f3f4f6; }
        .dark-card h4 { color: #38bdf8; font-size: 15px; border-bottom: 1px solid #1f2937; padding-bottom: 10px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }

        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body>

    <!-- Header do Administrador -->
    <header class="admin-header">
        <div class="nav-tabs">
            <a href="#" class="tab-btn active" onclick="trocarSecao('sec-computadores', this)"><i class="fa-solid fa-desktop" style="color: #0284c7;"></i> 💻 Computador (RMM)</a>
            <a href="#" class="tab-btn" onclick="trocarSecao('sec-ativos', this)"><i class="fa-solid fa-folder" style="color: #f59e0b;"></i> 📁 Ativos & Inventário</a>
            <a href="#" class="tab-btn" onclick="trocarSecao('sec-telefonia', this)"><i class="fa-solid fa-phone" style="color: #10b981;"></i> 📞 Telefonia IP & Ramais</a>
        </div>

        <div class="header-actions">
            <span style="font-size: 13px; font-weight: 700; margin: 0 10px; color: #334155;"><%= usuario %> (TI)</span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </header>

    <div class="container">
        
        <!-- SEÇÃO 1: RMM COMPUTADORES -->
        <div id="sec-computadores" class="tab-content active">
            <div class="card-table">
                <table>
                    <thead>
                        <tr>
                            <th>NOME</th><th>ENTIDADE</th><th>STATUS</th><th>TIPO</th><th>NOME ALTERNATIVO DO USUÁRIO</th>
                            <th>PROCESSADOR</th><th>MEMÓRIA</th><th>CONECTIVIDADE IP</th><th>ÚLTIMA ATUALIZAÇÃO</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% estacoes.forEach(function(maq) { 
                            const isOnline = (new Date() - new Date(maq.ultimaVez)) < 35000;
                        %>
                            <tr>
                                <td><strong>💻 <%= maq.hostname %></strong></td>
                                <td><%= maq.entidade || 'Entidade raiz > CST' %></td>
                                <td><span class="<%= isOnline ? 'badge-online' : 'badge-offline' %>"><%= isOnline ? 'Online' : 'Offline' %></span></td>
                                <td><%= maq.tipo || 'Desktop' %></td>
                                <td><%= maq.usuario %></td>
                                <td><%= maq.processador || 'Intel / AMD' %></td>
                                <td><strong><%= maq.ram_total || '8 GB' %></strong> (<%= maq.ram %>% uso)</td>
                                <td><strong><%= maq.ip %></strong></td>
                                <td style="color: #64748b;"><%= new Date(maq.ultimaVez).toLocaleTimeString() %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SEÇÃO 2: ATIVOS -->
        <div id="sec-ativos" class="tab-content">
            <div style="background: #fff; padding: 25px; border-radius: 8px;">
                <h3>📁 Gestão de Ativos</h3>
                <p style="color: #64748b;">Consulte a lista de inventário de hardware.</p>
            </div>
        </div>

        <!-- SEÇÃO 3: TELEFONIA IP EM TEMPO REAL (ATUALIZAÇÃO A CADA 3 SEG) -->
        <div id="sec-telefonia" class="tab-content">
            
            <!-- KPIs Telefonia -->
            <div class="telefonia-grid">
                <div class="kpi-box"><div class="kpi-title">TOTAL DE RAMAIS</div><div class="kpi-value" id="kpi-total" style="color: #38bdf8;">--</div></div>
                <div class="kpi-box"><div class="kpi-title">RAMAIS ONLINE</div><div class="kpi-value" id="kpi-online" style="color: #22c55e;">--</div></div>
                <div class="kpi-box"><div class="kpi-title">RAMAIS OFFLINE</div><div class="kpi-value" id="kpi-offline" style="color: #ef4444;">--</div></div>
                <div class="kpi-box"><div class="kpi-title">EM CHAMADA AGORA</div><div class="kpi-value" id="kpi-chamada" style="color: #60a5fa;">--</div></div>
                <div class="kpi-box"><div class="kpi-title">SEM REGISTRO SIP</div><div class="kpi-value" id="kpi-semsip" style="color: #f59e0b;">--</div></div>
                <div class="kpi-box"><div class="kpi-title">DISPONIBILIDADE</div><div class="kpi-value" id="kpi-disp" style="color: #34d399;">--%</div></div>
            </div>

            <div class="tel-dashboard">
                <!-- Tabela de Ramais e Latências -->
                <div class="dark-card">
                    <h4>
                        <span>📞 Tabela de Ramais IP (Ping & Latência a cada 5s)</span>
                        <span style="font-size: 11px; color: #34d399;" id="txtRelogioTel"><i class="fa-solid fa-rotate fa-spin"></i> Atualizando a cada 3s</span>
                    </h4>
                    
                    <table style="width: 100%; color: #e5e7eb;">
                        <thead>
                            <tr style="background: #1f2937; color: #9ca3af;">
                                <th>RAMAL</th><th>COLABORADOR / SETOR</th><th>IP DO RAMAL</th><th>MAC ADDRESS</th><th>STATUS</th><th>LATÊNCIA (PING)</th><th>AÇÃO TESTE</th>
                            </tr>
                        </thead>
                        <tbody id="tbRamaisCorpo">
                            <!-- Preenchido via JS a cada 3 segundos -->
                        </tbody>
                    </table>
                </div>

                <!-- Histórico e Chamadas Ativas em Tempo Real -->
                <div class="dark-card">
                    <h4><span>⚡ Chamadas Ativas & Histórico</span></h4>
                    
                    <div id="painelChamadasAtivas">
                        <!-- Preenchido via JS -->
                    </div>
                </div>
            </div>

        </div>

    </div>

    <script>
        function trocarSecao(secaoId, elemento) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(secaoId).classList.add('active');
            elemento.classList.add('active');
            if (secaoId === 'sec-telefonia') carregarTelefonia();
        }

        // --- ATUALIZAÇÃO DA TELEFONIA A CADA 3 SEGUNDOS ---
        async function carregarTelefonia() {
            try {
                const res = await fetch('/api/v1/telefonia/metrics');
                const dados = await res.json();
                
                // 1. Atualiza KPIs do topo
                document.getElementById('kpi-total').innerText = dados.resumo.total;
                document.getElementById('kpi-online').innerText = dados.resumo.online;
                document.getElementById('kpi-offline').innerText = dados.resumo.offline;
                document.getElementById('kpi-chamada').innerText = dados.resumo.emChamada;
                document.getElementById('kpi-semsip').innerText = dados.resumo.semSip;
                document.getElementById('kpi-disp').innerText = dados.resumo.disponibilidade + '%';

                // 2. Preenche Tabela de Ramais e Latências
                let htmlTb = '';
                dados.ramais.forEach(r => {
                    const statusBadge = r.status === 'Online' 
                        ? (r.emChamada ? '<span class="badge-call">📞 EM CHAMADA</span>' : '<span class="badge-online">🟢 Online</span>')
                        : '<span class="badge-offline">🔴 Offline</span>';

                    const latenciaText = r.status === 'Online' ? `<strong style="color:#34d399;">${r.latencia} ms</strong>` : '<span style="color:#ef4444;">Timeout</span>';

                    htmlTb += `
                        <tr>
                            <td style="font-weight:bold; color:#38bdf8;">${r.ramal}</td>
                            <td>${r.nome}</td>
                            <td><strong style="color:#60a5fa;">${r.ip}</strong></td>
                            <td style="font-size:11px; color:#9ca3af;">${r.mac}</td>
                            <td>${statusBadge}</td>
                            <td>${latenciaText}</td>
                            <td>
                                ${r.status === 'Online' ? `<button onclick="simularQueda('${r.ramal}')" style="background:#ef4444; color:#fff; border:none; padding:3px 8px; border-radius:4px; cursor:pointer; font-size:11px;">Simular Queda (E-mail)</button>` : '<span style="color:#9ca3af; font-size:11px;">Caiu</span>'}
                            </td>
                        </tr>
                    `;
                });
                document.getElementById('tbRamaisCorpo').innerHTML = htmlTb;

                // 3. Preenche Painel de Chamadas em Tempo Real
                let htmlChamadas = '';
                dados.chamadas.forEach(c => {
                    const isAtiva = c.status === 'EM CHAMADA';
                    htmlChamadas += `
                        <div style="background:#1f2937; border-left:4px solid ${isAtiva ? '#3b82f6' : '#64748b'}; padding:12px; margin-bottom:10px; border-radius:4px;">
                            <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:5px;">
                                <span style="font-weight:bold; color:${isAtiva ? '#60a5fa' : '#9ca3af'};">${c.status}</span>
                                <span style="color:#9ca3af;">⏱️ ${c.duracao}</span>
                            </div>
                            <div style="font-size:13px; font-weight:bold; color:#fff;">${c.origem}</div>
                            <div style="font-size:12px; color:#9ca3af;">➡️ ${c.destino}</div>
                        </div>
                    `;
                });
                document.getElementById('painelChamadasAtivas').innerHTML = htmlChamadas;

            } catch (e) {
                console.error("Erro ao atualizar telefonia", e);
            }
        }

        async function simularQueda(ramal) {
            if (!confirm("Deseja simular a queda de sinal do Ramal " + ramal + "? O sistema mudará o status para Offline e enviará um e-mail para ti@cstbh.com.br.")) return;
            await fetch('/api/v1/telefonia/simular-queda', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ramal })
            });
            alert("Simulação de queda enviada! Verifique a caixa de entrada ti@cstbh.com.br.");
            carregarTelefonia();
        }

        // Loop automático a cada 3 segundos na telefonia
        setInterval(() => {
            const secTel = document.getElementById('sec-telefonia');
            if (secTel && secTel.classList.contains('active')) {
                carregarTelefonia();
            }
        }, 3000);
    </script>
</body>
</html>
