<script>
function fecharModalInv() {
  const b = document.getElementById("boxNovoInventario");
  if (b) b.style.display = "none";
  const btn = document.getElementById("btnToggleInv") || document.getElementById("btnToggleInventario");
  if (btn) btn.innerHTML = "+ Adicionar Inventário";
}
document.addEventListener("keydown", e => { if (e.key === "Escape") fecharModalInv(); });

document.addEventListener("DOMContentLoaded", () => {
  // 1. Organiza o Modal Claro de Inventário
  const modal = document.getElementById("boxNovoInventario");
  if (modal) {
    modal.addEventListener("click", e => { if (e.target === modal) fecharModalInv(); });
    const inner = modal.querySelector(":scope > div");
    if (inner) {
      const h = document.createElement("div");
      h.style.cssText = "display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e8f0;padding-bottom:12px;margin-bottom:14px;";
      h.innerHTML = `
        <div>
          <h3 style="margin:0;font-size:18px;color:#0f172a;">📦 Novo Registro de Inventário</h3>
          <span style="font-size:12px;color:#64748b;">Escolha os equipamentos do colaborador e anexe a foto</span>
        </div>
        <button type="button" onclick="fecharModalInv()" style="background:#f1f5f9;border:none;width:32px;height:32px;border-radius:50%;font-size:16px;font-weight:bold;color:#475569;cursor:pointer;">✕</button>
      `;
      const oldH = inner.querySelector("h2,h3,h4");
      if (oldH) oldH.replaceWith(h); else inner.prepend(h);

      // Organiza os 2 inputs principais lado a lado
      const topInputs = Array.from(inner.querySelectorAll("input[type=text]")).slice(0, 2);
      if (topInputs.length === 2) {
        const wrapTop = document.createElement("div");
        wrapTop.className = "cst-topo-inputs";
        topInputs[0].parentNode.insertBefore(wrapTop, topInputs[0]);
        wrapTop.appendChild(topInputs[0]);
        wrapTop.appendChild(topInputs[1]);
      }

      // Organiza os cards e cria chips coloridos no topo
      const cores = [
        { nome: "🖥️ Gabinete", bg: "#dbeafe", txt: "#1d4ed8", brd: "#93c5fd", ativo: true },
        { nome: "🖵 Monitor 1", bg: "#e0e7ff", txt: "#4338ca", brd: "#a5b4fc", ativo: true },
        { nome: "🖵 Monitor 2", bg: "#f3e8ff", txt: "#7e22ce", brd: "#d8b4fe", ativo: false },
        { nome: "⌨️ Teclado/Mouse", bg: "#dcfce7", txt: "#15803d", brd: "#86efac", ativo: true },
        { nome: "🎧 Headset", bg: "#fef3c7", txt: "#b45309", brd: "#fcd34d", ativo: false },
        { nome: "📱 Celular", bg: "#ffe4e6", txt: "#be123c", brd: "#fda4af", ativo: false }
      ];
      const cards = Array.from(inner.querySelectorAll("div")).filter(d => d.querySelectorAll("input[type=file]").length === 1);
      if (cards.length > 0) {
        const barra = document.createElement("div");
        barra.className = "cst-chips-barra";
        const grade = document.createElement("div");
        grade.className = "cst-grade-cards";
        cards[0].parentNode.insertBefore(barra, cards[0]);
        cards[0].parentNode.insertBefore(grade, cards[0]);

        cards.forEach((card, i) => {
          const cfg = cores[i] || { nome: "Item " + (i+1), bg: "#e2e8f0", txt: "#334155", brd: "#cbd5e1", ativo: true };
          card.className = "cst-card-claro";
          card.style.display = cfg.ativo ? "block" : "none";
          grade.appendChild(card);

          const fi = card.querySelector("input[type=file]");
          if (fi) {
            fi.style.display = "none";
            const bf = document.createElement("button");
            bf.type = "button";
            bf.className = "cst-btn-foto";
            bf.innerHTML = "📷 Tirar Foto / Anexar";
            bf.onclick = () => fi.click();
            fi.onchange = () => {
              if (fi.files && fi.files[0]) {
                bf.classList.add("ok");
                bf.innerHTML = "✅ " + fi.files[0].name;
              }
            };
            fi.parentNode.insertBefore(bf, fi);
          }

          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = "cst-chip" + (cfg.ativo ? " ativo" : "");
          chip.style.cssText = `background:${cfg.bg};color:${cfg.txt};border-color:${cfg.brd};`;
          chip.innerHTML = (cfg.ativo ? "✓ " : "+ ") + cfg.nome;
          chip.onclick = () => {
            const on = card.style.display !== "none";
            card.style.display = on ? "none" : "block";
            chip.classList.toggle("ativo", !on);
            chip.innerHTML = (!on ? "✓ " : "+ ") + cfg.nome;
          };
          barra.appendChild(chip);
        });
      }

      // Coloca botão Cancelar ao lado de qualquer botão Salvar/Adicionar do modal
      const btnSalvar = Array.from(inner.querySelectorAll("button")).find(b => /Adicionar Ativo|Salvar/i.test(b.textContent));
      if (btnSalvar) {
        const rodape = document.createElement("div");
        rodape.className = "cst-rodape-modal";
        const btnCancel = document.createElement("button");
        btnCancel.type = "button";
        btnCancel.className = "cst-btn-sair";
        btnCancel.innerText = "Cancelar";
        btnCancel.onclick = fecharModalInv;
        btnSalvar.parentNode.insertBefore(rodape, btnSalvar);
        rodape.appendChild(btnCancel);
        rodape.appendChild(btnSalvar);
      }
    }
  }

  // 2. Remove linhas falsas ("Exemplo 1", "Exemplo 2") da tabela de Ativos Cadastrados
  document.querySelectorAll("tr").forEach(tr => {
    if (tr.textContent.includes("Exemplo 1") || tr.textContent.includes("Exemplo 2")) {
      tr.remove();
    }
  });
  document.querySelectorAll("table").forEach(tb => {
    const tbody = tb.querySelector("tbody");
    if (tbody && tbody.children.length === 0 && tb.textContent.includes("GABINETE")) {
      tbody.innerHTML = "<tr><td colspan=\"7\" style=\"text-align:center;padding:28px;color:#94a3b8;\">Nenhum ativo cadastrado ainda. Clique em <b>+ Adicionar Inventário</b> acima para registrar o primeiro kit.</td></tr>";
    }
  });
});

// 3. Atualiza em tempo real o monitoramento real de ramais e chamadas do net2phone
setInterval(async () => {
  try {
    const r = await fetch("/api/net2phone/painel");
    const d = await r.json();
    const tit = Array.from(document.querySelectorAll("*")).find(el => el.textContent && el.textContent.includes("Usuários em Atendimento ao Vivo (net2phone)") && el.children.length === 0);
    if (tit) {
      const card = tit.closest("div");
      const tbody = card ? card.querySelector("tbody") : null;
      if (tbody) {
        const linhas = [];
        d.chamadasAtivas.forEach(c => {
          linhas.push(`<tr style="background:rgba(34,197,94,0.08);"><td><b>${c.ramal}</b></td><td>${c.destino}</td><td><span style="color:#38bdf8;">${c.direcao}</span></td><td><span style="color:#4ade80;font-weight:bold;">● ${c.status}</span></td></tr>`);
        });
        d.ramaisOnline.forEach(rm => {
          if (!d.chamadasAtivas.some(c => c.ramal.includes(rm.maquina))) {
            linhas.push(`<tr><td><b>${rm.usuario}</b> <small style="color:#64748b;">(${rm.maquina})</small></td><td>${rm.ip}</td><td>Softphone RCon</td><td><span style="color:#94a3b8;">● ${rm.status}</span></td></tr>`);
          }
        });
        tbody.innerHTML = linhas.length > 0
          ? linhas.join("")
          : "<tr><td colspan=\"4\" style=\"text-align:center;color:#94a3b8;padding:18px;\">Nenhum ramal com Receptionist Console ativo detectado no momento</td></tr>";
      }
    }
  } catch (e) {}
}, 3000);
</script>
</body>
</html>
